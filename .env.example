# IMGBB_API_KEY: Required for ImgBB photo uploads.
# Configure this in the Secrets panel in the AI Studio UI.
# IMGBB_API_KEY=MY_IMGBB_API_KEY

# GOOGLE_DRIVE_API_KEY: Optional API key for Google Drive video streams.
# GOOGLE_DRIVE_API_KEY=MY_GOOGLE_DRIVE_KEY

# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
